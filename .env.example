# Copy to .env on the deploy box and fill in. .env is git-ignored — never commit real secrets.
# The image is built from the repo, which does NOT include web/agent_token.txt, so set the agent
# token here instead (env wins over the file).

# The token an AI must send to /api/agent/make (?token=... or Authorization: Bearer ...). Empty = open.
TRILO_AGENT_TOKEN=Claire the Trilobiter

# Stream measurements + the agent request log to a receiver (the Google Sheet web-app /exec URL).
# Leave both blank to keep recordings only in ./data/records on the box.
TRILO_RECORD_URL=
TRILO_RECORD_SECRET=

# TRILO_RECORD=0 turns recording off entirely; TRILO_AGENT=0 removes the agent routes.
